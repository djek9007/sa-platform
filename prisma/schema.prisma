generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String?
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lessonsProgress   LessonProgress[]
  assignmentSubms   AssignmentSubmission[]
  chatMessages      ChatMessage[]
}

model LessonProgress {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String   // "01/what-is-system-analysis"
  completed Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model AssignmentSubmission {
  id         String   @id @default(cuid())
  userId     String
  moduleId   String   // "01", "02", etc.
  content    String
  feedback   String?  // AI evaluation feedback (JSON)
  score      Float?   // AI score (0-10)
  evaluatedAt DateTime? // When AI evaluated
  submittedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String   // "user" | "assistant"
  content   String
  lessonContext String? // "moduleId/lessonSlug" - which lesson context
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
